---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  relatedSlugs?: string[];
  category?: string;
  limit?: number;
}

const { currentSlug, relatedSlugs, category, limit = 3 } = Astro.props;

const allArticles = await getCollection('articles');

let related: typeof allArticles = [];

// First, try to get explicitly specified related articles
if (relatedSlugs && relatedSlugs.length > 0) {
  related = allArticles.filter((a) => relatedSlugs.includes(a.slug));
}

// If we don't have enough, fill with same category
if (related.length < limit && category) {
  const sameCategoryArticles = allArticles
    .filter((a) => a.data.category === category && a.slug !== currentSlug && !related.some((r) => r.slug === a.slug))
    .slice(0, limit - related.length);
  related = [...related, ...sameCategoryArticles];
}

// Take only up to limit
related = related.slice(0, limit);
---

{related.length > 0 && (
  <section class="mt-12 pt-8 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Related Articles</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {related.map((article) => (
        <a
          href={`/${article.data.category}/${article.slug}/`}
          class="group block bg-gray-50 rounded-lg p-6 hover:bg-gray-100 transition-colors"
        >
          <h3 class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors line-clamp-2">
            {article.data.title}
          </h3>
          <p class="mt-2 text-sm text-gray-600 line-clamp-2">
            {article.data.description}
          </p>
        </a>
      ))}
    </div>
  </section>
)}
