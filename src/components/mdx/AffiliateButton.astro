---
import { amazonLink, affiliateLinkAttrs } from '@/utils/affiliate';

export interface Props {
  asin?: string;
  href?: string;
  text?: string;
  variant?: 'primary' | 'secondary';
}

const { asin, href, text = 'Check Price on Amazon', variant = 'primary' } = Astro.props;

const url = asin ? amazonLink(asin) : href;
const linkAttrs = affiliateLinkAttrs();

const buttonClass = variant === 'primary' ? 'affiliate-btn' : 'affiliate-btn-secondary';
---

{url && (
  <a
    href={url}
    class={`${buttonClass} inline-flex items-center gap-2`}
    {...linkAttrs}
  >
    {text}
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </a>
)}
