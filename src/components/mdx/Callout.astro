---
export interface Props {
  type?: 'info' | 'tip' | 'warning' | 'danger' | 'key-takeaway';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: {
    bg: 'bg-blue-50',
    border: 'border-blue-400',
    icon: 'text-blue-400',
    title: 'text-blue-800',
    text: 'text-blue-700',
  },
  tip: {
    bg: 'bg-green-50',
    border: 'border-green-400',
    icon: 'text-green-400',
    title: 'text-green-800',
    text: 'text-green-700',
  },
  warning: {
    bg: 'bg-yellow-50',
    border: 'border-yellow-400',
    icon: 'text-yellow-400',
    title: 'text-yellow-800',
    text: 'text-yellow-700',
  },
  danger: {
    bg: 'bg-red-50',
    border: 'border-red-400',
    icon: 'text-red-400',
    title: 'text-red-800',
    text: 'text-red-700',
  },
  'key-takeaway': {
    bg: 'bg-purple-50',
    border: 'border-purple-400',
    icon: 'text-purple-400',
    title: 'text-purple-800',
    text: 'text-purple-700',
  },
};

const defaultTitles = {
  info: 'Info',
  tip: 'Pro Tip',
  warning: 'Warning',
  danger: 'Safety Warning',
  'key-takeaway': 'Key Takeaway',
};

const style = styles[type];
const displayTitle = title || defaultTitles[type];
---

<aside class={`${style.bg} border-l-4 ${style.border} p-4 rounded-r-lg my-6`} role="note">
  <div class="flex">
    <div class="flex-shrink-0">
      {type === 'info' && (
        <svg class={`h-5 w-5 ${style.icon}`} viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
      )}
      {type === 'tip' && (
        <svg class={`h-5 w-5 ${style.icon}`} viewBox="0 0 20 20" fill="currentColor">
          <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
        </svg>
      )}
      {type === 'warning' && (
        <svg class={`h-5 w-5 ${style.icon}`} viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      )}
      {type === 'danger' && (
        <svg class={`h-5 w-5 ${style.icon}`} viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      )}
      {type === 'key-takeaway' && (
        <svg class={`h-5 w-5 ${style.icon}`} viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 3a1 1 0 00-1.447-.894L8.763 6H5a3 3 0 000 6h.28l1.771 5.316A1 1 0 008 18h1a1 1 0 001-1v-4.382l6.553 3.276A1 1 0 0018 15V3z" clip-rule="evenodd" />
        </svg>
      )}
    </div>
    <div class="ml-3">
      <h3 class={`text-sm font-semibold ${style.title}`}>{displayTitle}</h3>
      <div class={`mt-1 text-sm ${style.text}`}>
        <slot />
      </div>
    </div>
  </div>
</aside>
