---
export interface Props {
  title?: string;
  items: string[];
}

const { title = 'Key Takeaways', items } = Astro.props;
---

<aside class="my-8 bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200 rounded-lg p-6">
  <h3 class="flex items-center gap-2 text-lg font-bold text-purple-900 mb-4">
    <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M18 3a1 1 0 00-1.447-.894L8.763 6H5a3 3 0 000 6h.28l1.771 5.316A1 1 0 008 18h1a1 1 0 001-1v-4.382l6.553 3.276A1 1 0 0018 15V3z" clip-rule="evenodd" />
    </svg>
    {title}
  </h3>
  <ul class="space-y-3">
    {items.map((item) => (
      <li class="flex items-start gap-3 text-purple-900">
        <svg class="w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</aside>
