---
import { amazonLink, affiliateLinkAttrs } from '@/utils/affiliate';

export interface Props {
  name: string;
  brand?: string;
  asin?: string;
  image?: string;
  rating?: number;
  priceRange?: string;
  badge?: string;
  specs?: string[];
  pros?: string[];
  cons?: string[];
}

const {
  name,
  brand,
  asin,
  image,
  rating,
  priceRange,
  badge,
  specs = [],
  pros = [],
  cons = [],
} = Astro.props;

const amazonUrl = asin ? amazonLink(asin) : undefined;
const linkAttrs = affiliateLinkAttrs();
---

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  {badge && (
    <div class="bg-primary-600 text-white text-xs font-semibold px-3 py-1 text-center">
      {badge}
    </div>
  )}

  <div class="p-6">
    {image && (
      <div class="mb-4 flex justify-center">
        <img
          src={image}
          alt={name}
          class="h-40 w-auto object-contain"
          loading="lazy"
        />
      </div>
    )}

    <div class="text-center mb-4">
      {brand && <p class="text-sm text-gray-500">{brand}</p>}
      <h3 class="text-lg font-bold text-gray-900">{name}</h3>

      {rating && (
        <div class="flex items-center justify-center mt-2 gap-1">
          <div class="flex text-yellow-400">
            {[1, 2, 3, 4, 5].map((star) => (
              <svg
                class={`w-4 h-4 ${star <= Math.floor(rating) ? 'fill-current' : 'fill-gray-300'}`}
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-sm text-gray-600">{rating}/5</span>
        </div>
      )}

      {priceRange && (
        <p class="text-lg font-semibold text-gray-900 mt-2">{priceRange}</p>
      )}
    </div>

    {specs.length > 0 && (
      <ul class="text-sm text-gray-600 mb-4 space-y-1">
        {specs.map((spec) => (
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            {spec}
          </li>
        ))}
      </ul>
    )}

    {(pros.length > 0 || cons.length > 0) && (
      <div class="grid grid-cols-2 gap-4 text-sm mb-4">
        {pros.length > 0 && (
          <div>
            <p class="font-semibold text-green-700 mb-1">Pros</p>
            <ul class="space-y-1">
              {pros.slice(0, 3).map((pro) => (
                <li class="flex items-start gap-1 text-gray-600">
                  <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {cons.length > 0 && (
          <div>
            <p class="font-semibold text-red-700 mb-1">Cons</p>
            <ul class="space-y-1">
              {cons.slice(0, 3).map((con) => (
                <li class="flex items-start gap-1 text-gray-600">
                  <svg class="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {amazonUrl && (
      <a
        href={amazonUrl}
        class="affiliate-btn w-full text-center"
        {...linkAttrs}
      >
        Check Price on Amazon
      </a>
    )}
  </div>
</div>
