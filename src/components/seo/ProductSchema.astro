---
import siteData from '@/data/site.json';

export interface ProductProps {
  name: string;
  brand: string;
  description?: string;
  sku?: string;
  asin?: string;
  rating?: number;
  priceRange?: string;
  image?: string;
  url?: string;
}

export interface Props {
  product: ProductProps;
  reviewRating?: number;
  reviewCount?: number;
}

const { product, reviewRating, reviewCount } = Astro.props;

// Parse price range like "$280 - $350" to get min/max
const parsePrice = (priceRange?: string) => {
  if (!priceRange) return null;
  const matches = priceRange.match(/\$?([\d,]+)/g);
  if (matches && matches.length >= 1) {
    const prices = matches.map(p => parseFloat(p.replace(/[$,]/g, '')));
    return {
      minPrice: Math.min(...prices),
      maxPrice: Math.max(...prices),
    };
  }
  return null;
};

const prices = parsePrice(product.priceRange);

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  brand: {
    '@type': 'Brand',
    name: product.brand,
  },
  description: product.description || `${product.name} transfer switch by ${product.brand}`,
  ...(product.sku && { sku: product.sku }),
  ...(product.asin && { gtin13: product.asin }),
  ...(product.image && {
    image: product.image.startsWith('http') ? product.image : `${siteData.url}${product.image}`
  }),
};

// Add offers with price
if (prices) {
  schema.offers = {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: prices.minPrice,
    highPrice: prices.maxPrice,
    offerCount: 1,
    availability: 'https://schema.org/InStock',
    ...(product.url && { url: product.url }),
  };
}

// Add aggregate rating
if (reviewRating && reviewCount) {
  schema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviewRating,
    reviewCount: reviewCount,
    bestRating: 5,
    worstRating: 1,
  };
}

// Add individual review/rating
if (product.rating) {
  schema.review = {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: product.rating,
      bestRating: 5,
      worstRating: 1,
    },
    author: {
      '@type': 'Organization',
      name: siteData.name,
    },
  };

  // Also add as aggregate if no reviewCount provided
  if (!reviewCount) {
    schema.aggregateRating = {
      '@type': 'AggregateRating',
      ratingValue: product.rating,
      reviewCount: 1,
      bestRating: 5,
      worstRating: 1,
    };
  }
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
