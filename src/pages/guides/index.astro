---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateDisplay } from '@/utils/seo';

const allArticles = await getCollection('articles');
const guides = allArticles
  .filter((a) => a.data.category === 'guides' || a.data.category === 'how-to' || a.data.category === 'installation')
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const pillarGuides = guides.filter((a) => a.data.contentType === 'pillar');
const otherGuides = guides.filter((a) => a.data.contentType !== 'pillar');
---

<BaseLayout
  title="Transfer Switch Guides"
  description="Comprehensive guides on generator transfer switches. Learn about types, sizing, installation, costs, and more."
>
  <div class="py-12 md:py-16">
    <div class="container-wide">
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Transfer Switch Guides</h1>
        <p class="text-xl text-gray-600 max-w-3xl">
          Everything you need to know about generator transfer switches—from choosing the right type to installation and maintenance.
        </p>
      </header>

      {pillarGuides.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Essential Guides</h2>
          <div class="grid md:grid-cols-2 gap-8">
            {pillarGuides.map((guide) => (
              <a
                href={`/guides/${guide.slug}/`}
                class="block bg-gradient-to-br from-primary-50 to-blue-50 border border-primary-200 rounded-lg p-6 hover:shadow-lg transition-shadow"
              >
                <span class="inline-block px-2 py-1 text-xs font-semibold bg-primary-600 text-white rounded mb-3">
                  Essential Guide
                </span>
                <h3 class="text-xl font-bold text-gray-900 mb-2">{guide.data.title}</h3>
                <p class="text-gray-600 mb-4">{guide.data.description}</p>
                <span class="text-primary-600 font-medium">Read guide →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">All Guides</h2>
        {guides.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {guides.map((guide) => (
              <article class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
                <a href={`/guides/${guide.slug}/`} class="block p-6">
                  <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 hover:text-primary-600 transition-colors">
                    {guide.data.title}
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                    {guide.data.description}
                  </p>
                  <time class="text-xs text-gray-500" datetime={guide.data.publishDate.toISOString()}>
                    {formatDateDisplay(guide.data.publishDate)}
                  </time>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-gray-600">Guides coming soon. Check back later!</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
