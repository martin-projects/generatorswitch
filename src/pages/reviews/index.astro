---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateDisplay } from '@/utils/seo';

const allArticles = await getCollection('articles');
const reviews = allArticles
  .filter((a) => a.data.category === 'reviews' || a.data.contentType === 'buyer-intent')
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredReviews = reviews.filter((a) => a.data.featured);
---

<BaseLayout
  title="Transfer Switch Reviews"
  description="In-depth reviews of the best generator transfer switches. Compare Generac, Reliance, and more with our expert analysis."
>
  <div class="py-12 md:py-16">
    <div class="container-wide">
      <header class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Transfer Switch Reviews</h1>
        <p class="text-xl text-gray-600 max-w-3xl">
          Honest, detailed reviews to help you choose the best transfer switch for your generator and home.
        </p>
      </header>

      {featuredReviews.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Featured Reviews</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredReviews.map((review) => (
              <a
                href={`/reviews/${review.slug}/`}
                class="block bg-gradient-to-br from-yellow-50 to-orange-50 border border-yellow-200 rounded-lg p-6 hover:shadow-lg transition-shadow"
              >
                <span class="inline-block px-2 py-1 text-xs font-semibold bg-yellow-500 text-white rounded mb-3">
                  Featured
                </span>
                <h3 class="text-lg font-bold text-gray-900 mb-2">{review.data.title}</h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">{review.data.description}</p>
                <span class="text-primary-600 font-medium">Read review →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">All Reviews</h2>
        {reviews.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {reviews.map((review) => (
              <article class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
                <a href={`/reviews/${review.slug}/`} class="block p-6">
                  <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 hover:text-primary-600 transition-colors">
                    {review.data.title}
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                    {review.data.description}
                  </p>
                  <time class="text-xs text-gray-500" datetime={review.data.publishDate.toISOString()}>
                    {formatDateDisplay(review.data.publishDate)}
                  </time>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-gray-600">Reviews coming soon. Check back later!</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
