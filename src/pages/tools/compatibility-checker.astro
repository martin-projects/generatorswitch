---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Compatibility Checker"
  description="Check if a transfer switch is compatible with your generator and electrical panel."
>
  <div class="py-12 md:py-16">
    <div class="container-narrow">
      <header class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Compatibility Checker</h1>
        <p class="text-xl text-gray-600">
          Verify that a transfer switch will work with your generator and electrical system.
        </p>
      </header>

      <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-lg font-medium">Interactive Tool Coming Soon</p>
          <p class="text-sm mt-2">Check our <a href="/guides/" class="text-primary-600 hover:underline">guides</a> for compatibility information.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
