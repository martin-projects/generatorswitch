---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Installation Cost Estimator"
  description="Estimate the cost of transfer switch installation in your area based on switch type and complexity."
>
  <div class="py-12 md:py-16">
    <div class="container-narrow">
      <header class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Installation Cost Estimator</h1>
        <p class="text-xl text-gray-600">
          Get an estimate of what transfer switch installation will cost in your area.
        </p>
      </header>

      <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-lg font-medium">Interactive Estimator Coming Soon</p>
          <p class="text-sm mt-2">See our <a href="/guides/transfer-switch-installation-cost/" class="text-primary-600 hover:underline">installation cost guide</a> for detailed pricing.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
