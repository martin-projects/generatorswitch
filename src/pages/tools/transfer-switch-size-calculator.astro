---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Transfer Switch Size Calculator"
  description="Free calculator to find the right transfer switch size for your generator. Enter your specs and get personalized recommendations."
>
  <div class="py-12 md:py-16">
    <div class="container-narrow">
      <header class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Transfer Switch Size Calculator</h1>
        <p class="text-xl text-gray-600">
          Find the right transfer switch size based on your generator and home electrical needs.
        </p>
      </header>

      <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
        <div id="calculator" class="space-y-6">
          <!-- Calculator Form -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="panel-amps">
              Main Electrical Panel Size
            </label>
            <select
              id="panel-amps"
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
            >
              <option value="">Select your panel size...</option>
              <option value="100">100 Amp</option>
              <option value="150">150 Amp</option>
              <option value="200">200 Amp</option>
              <option value="400">400 Amp</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="generator-watts">
              Generator Wattage
            </label>
            <input
              type="number"
              id="generator-watts"
              placeholder="e.g., 7500"
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
            />
            <p class="mt-1 text-sm text-gray-500">Enter your generator's running (rated) watts</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Transfer Switch Type Preference
            </label>
            <div class="flex gap-4">
              <label class="flex items-center">
                <input type="radio" name="switch-type" value="manual" class="text-primary-600 focus:ring-primary-500" checked />
                <span class="ml-2 text-gray-700">Manual</span>
              </label>
              <label class="flex items-center">
                <input type="radio" name="switch-type" value="automatic" class="text-primary-600 focus:ring-primary-500" />
                <span class="ml-2 text-gray-700">Automatic</span>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="circuits-needed">
              How many circuits do you need to power?
            </label>
            <select
              id="circuits-needed"
              class="w-full rounded-lg border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500"
            >
              <option value="6">6 circuits (essentials only)</option>
              <option value="10" selected>10 circuits (recommended)</option>
              <option value="whole">Whole house</option>
            </select>
          </div>

          <button
            id="calculate-btn"
            class="w-full affiliate-btn"
          >
            Calculate Recommended Size
          </button>
        </div>

        <!-- Results Section (hidden by default) -->
        <div id="results" class="hidden mt-8 pt-8 border-t border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Your Recommendation</h2>
          <div class="bg-primary-50 rounded-lg p-6 mb-6">
            <p class="text-sm text-primary-700 font-medium">Recommended Transfer Switch Size</p>
            <p id="result-size" class="text-3xl font-bold text-primary-900">30 Amp</p>
          </div>
          <div id="result-explanation" class="text-gray-600 mb-6">
            <!-- Dynamic explanation -->
          </div>

          <!-- Product Recommendations -->
          <div id="product-recommendations" class="mt-8">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Recommended Products</h3>
            <div id="product-cards" class="space-y-4">
              <!-- Dynamic product cards -->
            </div>
          </div>

          <div class="bg-gray-50 rounded-lg p-4 mt-6">
            <p class="text-sm text-gray-600"><strong>Note:</strong> This is a general recommendation. For a complete assessment, consult a licensed electrician who can evaluate your specific electrical system.</p>
          </div>
        </div>
      </div>

      <!-- Educational Content -->
      <div class="mt-12 prose prose-lg max-w-none">
        <h2>How to Size a Transfer Switch</h2>
        <p>
          Choosing the correct transfer switch size is crucial for safe and effective backup power. Here's what you need to consider:
        </p>

        <h3>Match Your Generator Output</h3>
        <p>
          Your transfer switch should match your generator's output capacity. A common formula:
        </p>
        <ul>
          <li><strong>Watts ÷ Volts = Amps</strong></li>
          <li>Example: 7,500W ÷ 240V = 31.25A → Use a 30A transfer switch</li>
        </ul>

        <h3>Consider Your Electrical Panel</h3>
        <p>
          The transfer switch should not exceed your main panel's capacity. Most homes have 100A, 150A, or 200A service.
        </p>

        <h3>Common Transfer Switch Sizes</h3>
        <table>
          <thead>
            <tr>
              <th>Switch Size</th>
              <th>Generator Range</th>
              <th>Typical Use</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>30 Amp</td>
              <td>5,000 - 7,500W</td>
              <td>Portable generators, essential circuits</td>
            </tr>
            <tr>
              <td>50 Amp</td>
              <td>10,000 - 12,000W</td>
              <td>Large portable or small standby generators</td>
            </tr>
            <tr>
              <td>100 Amp</td>
              <td>15,000 - 22,000W</td>
              <td>Whole-house standby generators</td>
            </tr>
            <tr>
              <td>200 Amp</td>
              <td>22,000W+</td>
              <td>Large homes, service entrance rated</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Product database with affiliate links
  const products = {
    manual: {
      30: [
        {
          name: 'Reliance Controls 310CRK',
          description: '30A, 10-circuit complete kit with inlet box and cord',
          price: '$280 - $350',
          badge: 'Best Overall',
          url: 'https://www.amazon.com/dp/B000BQM9HQ?tag=112233445504b-20'
        },
        {
          name: 'Reliance Controls 306LRK',
          description: '30A, 6-circuit kit - great budget option',
          price: '$170 - $220',
          badge: 'Best Value',
          url: 'https://www.amazon.com/dp/B001GSELEO?tag=112233445504b-20'
        }
      ],
      50: [
        {
          name: 'Reliance Controls 510CRK',
          description: '50A, 10-circuit kit for larger generators',
          price: '$350 - $420',
          badge: 'Best 50 Amp',
          url: 'https://www.amazon.com/dp/B003VNTEO4?tag=112233445504b-20'
        }
      ],
      100: [
        {
          name: 'Generac 6853 Home Link',
          description: '30A manual transfer switch with upgrade path',
          price: '$320 - $380',
          badge: 'Professional Grade',
          url: 'https://www.amazon.com/dp/B00LXSWNZG?tag=112233445504b-20'
        }
      ]
    },
    automatic: {
      100: [
        {
          name: 'Generac 6853 Home Link',
          description: '30A manual switch, upgradeable to automatic',
          price: '$320 - $380',
          badge: 'Best Upgrade Path',
          url: 'https://www.amazon.com/dp/B00LXSWNZG?tag=112233445504b-20'
        }
      ],
      200: [
        {
          name: 'Reliance Controls 310CRK',
          description: '30A 10-circuit complete kit - Best for most homes',
          price: '$280 - $350',
          badge: 'Best Overall',
          url: 'https://www.amazon.com/dp/B000BQM9HQ?tag=112233445504b-20'
        }
      ]
    }
  };

  const calculateBtn = document.getElementById('calculate-btn');
  const resultsSection = document.getElementById('results');
  const resultSize = document.getElementById('result-size');
  const resultExplanation = document.getElementById('result-explanation');
  const productCards = document.getElementById('product-cards');

  calculateBtn?.addEventListener('click', () => {
    const panelAmps = (document.getElementById('panel-amps') as HTMLSelectElement)?.value;
    const generatorWatts = parseInt((document.getElementById('generator-watts') as HTMLInputElement)?.value || '0');
    const switchType = (document.querySelector('input[name="switch-type"]:checked') as HTMLInputElement)?.value;
    const circuitsNeeded = (document.getElementById('circuits-needed') as HTMLSelectElement)?.value;

    if (!panelAmps || !generatorWatts) {
      alert('Please fill in all fields');
      return;
    }

    // Calculate recommended amps (watts / 240V)
    const calculatedAmps = generatorWatts / 240;
    let recommendedSize: number;

    if (calculatedAmps <= 30) {
      recommendedSize = 30;
    } else if (calculatedAmps <= 50) {
      recommendedSize = 50;
    } else if (calculatedAmps <= 100) {
      recommendedSize = 100;
    } else {
      recommendedSize = 200;
    }

    // For automatic + whole house, recommend higher
    if (switchType === 'automatic' && circuitsNeeded === 'whole') {
      recommendedSize = Math.max(recommendedSize, 100);
    }

    // Ensure we don't exceed panel capacity
    const panelLimit = parseInt(panelAmps);
    if (recommendedSize > panelLimit) {
      recommendedSize = panelLimit;
    }

    resultSize!.textContent = `${recommendedSize} Amp`;
    resultExplanation!.innerHTML = `
      <p>Based on your <strong>${generatorWatts.toLocaleString()}W generator</strong> (≈${Math.round(calculatedAmps)}A at 240V) and <strong>${panelAmps}A panel</strong>, we recommend a <strong>${recommendedSize} amp ${switchType} transfer switch</strong>.</p>
      <p class="mt-2">This size provides adequate capacity for your generator while staying within your electrical panel's limits.</p>
    `;

    // Get product recommendations
    const typeProducts = products[switchType as keyof typeof products] || products.manual;
    let recommendedProducts = typeProducts[recommendedSize as keyof typeof typeProducts] || [];

    // Fallback to 30A manual if no products found
    if (recommendedProducts.length === 0 && switchType === 'manual') {
      recommendedProducts = products.manual[30];
    }
    if (recommendedProducts.length === 0 && switchType === 'automatic') {
      recommendedProducts = products.automatic[200];
    }

    // Render product cards
    productCards!.innerHTML = recommendedProducts.map((product: any) => `
      <div class="bg-white border border-gray-200 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="inline-block bg-primary-100 text-primary-700 text-xs font-medium px-2 py-1 rounded mb-2">${product.badge}</span>
          <h4 class="font-bold text-gray-900">${product.name}</h4>
          <p class="text-sm text-gray-600">${product.description}</p>
          <p class="text-sm font-medium text-gray-900 mt-1">${product.price}</p>
        </div>
        <a href="${product.url}" class="affiliate-btn whitespace-nowrap" target="_blank" rel="sponsored noopener">
          Check Price
        </a>
      </div>
    `).join('');

    resultsSection?.classList.remove('hidden');
    resultsSection?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
