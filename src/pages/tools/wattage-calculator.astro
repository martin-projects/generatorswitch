---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Wattage Calculator"
  description="Calculate your home's power needs during an outage. Add appliances and see your total wattage requirements."
>
  <div class="py-12 md:py-16">
    <div class="container-narrow">
      <header class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Wattage Calculator</h1>
        <p class="text-xl text-gray-600">
          Calculate how much power you need by selecting the appliances you want to run during an outage.
        </p>
      </header>

      <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
        <p class="text-gray-600 mb-6">
          Select the appliances you want to power during an outage. We'll calculate your total running and starting watts.
        </p>

        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
          <p class="text-lg font-medium">Interactive Calculator Coming Soon</p>
          <p class="text-sm mt-2">In the meantime, check out our <a href="/guides/how-to-size-transfer-switch/" class="text-primary-600 hover:underline">sizing guide</a>.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
